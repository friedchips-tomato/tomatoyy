.hero {
  padding: 24rpx 8rpx 40rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-slogan {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #646a73;
}

.entry-list {
  margin-bottom: 24rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.06);
  min-height: 132rpx;
  box-sizing: border-box;
}

.entry-card-hover {
  background-color: #eef4ff;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.entry-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.5;
}

.entry-arrow {
  flex: none;
  margin-left: 20rpx;
  font-size: 44rpx;
  color: #c4c8ce;
  line-height: 1;
}

.tip {
  padding: 8rpx 8rpx 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8a9099;
  line-height: 1.6;
}
