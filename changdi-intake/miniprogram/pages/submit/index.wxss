.field-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #646a73;
}

.submit-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2329;
}

.reason-input {
  margin-top: 8rpx;
  width: 100%;
  min-height: 180rpx;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  box-sizing: border-box;
}

.picker-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.select-chip {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 12rpx 24rpx;
  background-color: #f5f6f8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #1f2329;
}

.count-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.count-text {
  font-size: 24rpx;
}

.error-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #d83931;
}

.warning-text {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #d83931;
  line-height: 1.6;
}

.code-text {
  display: block;
  word-break: break-all;
  font-size: 30rpx;
  color: #1f2329;
}

.receipt-code {
  display: block;
  width: 320rpx;
  height: 320rpx;
  margin-top: 16rpx;
  background-color: #f5f6f8;
  border-radius: 12rpx;
}

.locked-card {
  margin-top: 24rpx;
  box-shadow: none;
  background-color: #f5f6f8;
}

.token-text {
  font-weight: 600;
}

.spaced {
  margin-top: 24rpx;
}
