.form {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.code-input {
  height: 88rpx;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2329;
}

.code-placeholder {
  color: #a4a9b0;
  font-size: 28rpx;
}

.actions {
  display: flex;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
  margin: 0 8rpx;
  padding: 22rpx 16rpx;
  font-size: 30rpx;
}

.feedback {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.feedback-text {
  display: block;
  font-size: 28rpx;
  color: #646a73;
  line-height: 1.6;
}

.retry {
  margin-top: 24rpx;
  width: 100%;
}

.result {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #8a9099;
}

.label.spaced {
  margin-top: 28rpx;
}

.case-number {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  word-break: break-all;
}

.status {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f6feb;
}

.timeline {
  margin-top: 8rpx;
}

.milestone {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f0f1f3;
}

.milestone:last-child {
  border-bottom: none;
}

.milestone-status {
  font-size: 28rpx;
  color: #1f2329;
}

.milestone-time {
  font-size: 26rpx;
  color: #646a73;
}

.tip {
  padding: 8rpx 8rpx 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8a9099;
  line-height: 1.6;
}

.verify-entry {
  margin-top: 32rpx;
}

.panel {
  margin-top: 8rpx;
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.close {
  font-size: 26rpx;
  color: #646a73;
  padding: 8rpx 4rpx;
}

.token-input {
  margin-top: 24rpx;
}

.verify-submit {
  width: 100%;
}

.round {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f0f1f3;
}

.round:last-child {
  border-bottom: none;
}

.round-label {
  display: block;
  font-size: 26rpx;
  color: #8a9099;
}

.round-time {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #646a73;
}

.round-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.7;
}

.evaluation {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background-color: #f5f6f8;
  border-radius: 12rpx;
}

.evaluation-text {
  display: block;
  font-size: 25rpx;
  color: #646a73;
}

.evaluation-comment {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #1f2329;
  line-height: 1.6;
}

.action-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f1f3;
}

.action-block > .muted {
  display: block;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  font-size: 25rpx;
}

.score-row {
  display: flex;
  margin-bottom: 12rpx;
}

.score {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1f2329;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.score-active {
  background-color: #1f6feb;
  color: #ffffff;
}

.reason-input {
  margin-top: 16rpx;
  width: 100%;
  min-height: 140rpx;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  box-sizing: border-box;
}

.action-button {
  margin-top: 20rpx;
  width: 100%;
}

.action-feedback {
  margin-top: 24rpx;
  box-shadow: none;
  background-color: #f5f6f8;
}
.feedback-photo-button {
  margin-top: 16rpx;
}

.feedback-photo {
  display: block;
  width: 100%;
  height: 420rpx;
  margin: 16rpx 0;
  background: #f3f6fa;
}
