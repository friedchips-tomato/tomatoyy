.actions {
  display: flex;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.actions button {
  flex: 1;
  margin: 0 8rpx 0 0;
  padding: 22rpx 16rpx;
  font-size: 28rpx;
}

.actions button:last-child {
  margin-right: 0;
}

.feedback {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.entry-card {
  padding-top: 28rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #8a9099;
}

.label.spaced {
  margin-top: 24rpx;
}

.case-number {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  word-break: break-all;
}

.status {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f6feb;
}

.warning-text {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #d83931;
  line-height: 1.6;
}

.tip {
  padding: 8rpx 8rpx 24rpx;
}

.spaced {
  margin-top: 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8a9099;
  line-height: 1.6;
}
