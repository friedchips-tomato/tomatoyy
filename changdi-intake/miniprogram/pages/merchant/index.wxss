.merchant-shell .merchant-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.merchant-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}

.merchant-block {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.6;
}

.merchant-block.warning {
  color: #d83931;
}

.merchant-notice {
  display: block;
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background-color: #fff7e6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #ad6800;
}

.field-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #646a73;
}

.merchant-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2329;
}

.text-area {
  height: auto;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.7;
}

.spaced {
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.text-button {
  background-color: transparent;
  color: #1f6feb;
  font-size: 26rpx;
  padding: 8rpx 4rpx;
  line-height: 1.4;
}

.text-button::after {
  border: none;
}

.select-chip {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 12rpx 24rpx;
  background-color: #f5f6f8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #1f2329;
}

.picker-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.case-row {
  display: block;
  width: 100%;
  text-align: left;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.case-row::after {
  border: none;
}

.row-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  word-break: break-all;
}

.status-tag {
  display: inline-block;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  background-color: #e6f0ff;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #1f6feb;
}

.case-number {
  word-break: break-all;
}

.detail-copy {
  color: #1f2329;
  line-height: 1.7;
}

.history-row {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f1f3;
}

.history-row:last-child {
  border-bottom: none;
}

.support-note {
  color: #8a9099;
  font-size: 24rpx;
}

.back-list {
  margin-bottom: 24rpx;
}

.merchant-photo-preview {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 14rpx;
  background: #edf3fa;
  border-radius: 12rpx;
}
.receipt-image {
  display: block;
  width: 320rpx;
  height: 320rpx;
  margin: 20rpx auto 0;
}
