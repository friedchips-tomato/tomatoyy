page {
  background-color: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #646a73;
  font-size: 26rpx;
}

.button-primary {
  background-color: #1f6feb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  padding: 24rpx 32rpx;
  line-height: 1.4;
  text-align: center;
  border: none;
}

.button-primary::after {
  border: none;
}

.button-secondary {
  background-color: #ffffff;
  color: #1f6feb;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  padding: 24rpx 32rpx;
  line-height: 1.4;
  text-align: center;
  border: 2rpx solid #1f6feb;
}

.button-secondary::after {
  border: none;
}
